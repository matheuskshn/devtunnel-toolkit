{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "devtunnel-toolkit",
      "version-file": "version.txt",
      "initial-version": "0.1.0-rc.1",
      "include-component-in-tag": false,
      "draft": true,
      "force-tag-creation": true,
      "prerelease": true,
      "versioning": "prerelease",
      "prerelease-type": "rc",
      "bump-minor-pre-major": true,
      "extra-files": [
        {"type": "json", "path": "images/hub/package.json", "jsonpath": "$.version"},
        {"type": "json", "path": "images/hub/package-lock.json", "jsonpath": "$.version"},
        {"type": "json", "path": "images/hub/package-lock.json", "jsonpath": "$.packages[''].version"}
      ]
    }
  }
}
