# Optional client-side selective route proxy.
# Copy this file to .env.route-proxy and replace only the local values there.
# Never commit real internal hostnames, proxy addresses, or network topology.

ROUTE_PROXY_IMAGE=devtunnel-toolkit-route-proxy:local
ROUTE_PROXY_LISTEN_ADDRESS=127.0.0.1
ROUTE_PROXY_PORT=8888

# By default, devtunnel connect exposes the remote Squid proxy locally on 3140.
ROUTE_PROXY_UPSTREAM_HOST=127.0.0.1
ROUTE_PROXY_UPSTREAM_PORT=3140

# Comma-separated exact hosts or leading-dot domain patterns.
ROUTE_PROXY_HOSTS=api.internal.example.test,.services.internal.example.test

# Space-separated ports allowed for HTTPS or other CONNECT tunnels.
ROUTE_PROXY_CONNECT_PORTS=443
