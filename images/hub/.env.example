# Copy outside the repository and customize for your deployment.
# Docker: --env-file /absolute/path/hub.env
# Compose: set HUB_ENV_FILE to that path with compose.environment.yml.
# ACA/Kubernetes: supply the same variables in the container environment.
# Precedence: environment > optional JSON file > defaults. Restart to apply.
# Lists are comma-separated; never put user login tokens here.

HUB_ID=devhub
# Resolved once after verified login. Existing fixed names never change.
HUB_TUNNEL_NAME_TEMPLATE={hub_id}-{username}
# Published tunnel/client proxy port, not the per-session Squid listener.
# Range 1024-65535; must not overlap listeners, health or web console ports.
# Also editable in the web console policy with all sessions stopped.
HUB_PROXY_PORT=3140
# Optional SOCKS5 TCP CONNECT through the same per-session Squid policy.
# Disabled until explicitly enabled. No UDP, BIND or direct external listener.
HUB_SOCKS_ENABLED=false
HUB_SOCKS_PORT=3180
HUB_ALLOWED_PROVIDERS=microsoft
# Replace with the permitted Microsoft tenant UUID. Empty permits any tenant.
HUB_ALLOWED_MICROSOFT_TENANTS=00000000-0000-0000-0000-000000000000
# Exact DNS names, or a leading dot for a domain and its subdomains.
# Empty denies all proxy destinations unless HUB_ALLOW_ALL_DOMAINS=true.
HUB_ALLOWED_DOMAINS=service.example.com,.example.org
# Explicit opt-in: bypass domain filtering (including literal IP destinations).
# Source, destination-port, loopback and metadata restrictions still apply.
HUB_ALLOW_ALL_DOMAINS=false
HUB_ALLOWED_PORTS=80,443
HUB_CONNECT_PORTS=443

HUB_MAX_SESSIONS=50
HUB_LISTENER_START=18001
HUB_LISTENER_END=18999
# Match deployment HTTP probes if changing this port.
HUB_HEALTH_PORT=8080
HUB_MAINTENANCE_SECONDS=300

# filesystem (default): persistent state and homes on a data volume.
# postgres: database state and encrypted credential packages, no data volume.
HUB_STORAGE_BACKEND=filesystem
HUB_DATA_DIR=/data
# Ephemeral writable directory. Use /tmp/hub with the ACA example.
HUB_RUN_DIR=/run/hub

# Optional web console, served by the same Node process. Disabled by default.
# Production: HTTPS at your reverse proxy, forwarding the original Host header.
# Local Docker: publish only on loopback, e.g. 127.0.0.1:8082:8082.
HUB_WEB_ENABLED=false
# true: require a change after account creation/reset. false: allow access with
# a persistent warning until the user changes their password. Restart to apply.
HUB_WEB_REQUIRE_PASSWORD_CHANGE=true
# HUB_WEB_PORT=8082
# HUB_WEB_ORIGIN=http://localhost:8082
# Separate random 32-byte base64 key. Keep stable across restarts and restores.
# Required when enabled. Store outside the repository, via an executor secret.
# HUB_WEB_KEY=
# Configure providers, users and operating policy inside the authenticated UI.
# Saved UI policy overrides matching JSON/environment values while web is enabled.

# Optional JSON configuration. Leave unset for environment-only operation.
# If set, this file must exist inside the container (usually a read-only mount).
# HUB_CONFIG=/config/hub.json

# PostgreSQL alternative. Provision the database separately, then inject these
# variables. In ACA use secretRef for password/key, in Kubernetes secretKeyRef.
# HUB_STORAGE_BACKEND=postgres
# HUB_PG_HOST=postgres.example.com
# HUB_PG_PORT=5432
# HUB_PG_DATABASE=devtunnel_hub
# HUB_PG_USER=hub
# HUB_PG_PASSWORD=
# HUB_PG_SSLMODE=verify-full
# Optional PEM CA bundle mounted read-only. System trust is used otherwise.
# HUB_PG_CA_FILE=/config/database-ca.pem
# Generate a separate random 32-byte base64 key outside this repository.
# Retain the same key across replicas/revisions and database restores.
# HUB_CREDENTIAL_KEY=
# HUB_CREDENTIAL_KEY_ID=primary
# Rotation only: JSON object mapping previous key IDs to base64 keys.
# HUB_CREDENTIAL_PREVIOUS_KEYS=
