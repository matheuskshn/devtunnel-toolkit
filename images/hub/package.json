{
  "name": "devtunnel-toolkit-hub",
  "version": "0.1.0-rc.4",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test --test-timeout=30000 tests/*.test.mjs",
    "test:coverage": "node tests/coverage.mjs",
    "test:container": "node tests/container-smoke.mjs && node tests/web-container-smoke.mjs",
    "test:postgres": "node tests/postgres-smoke.mjs",
    "check:public": "node tests/public-content.mjs"
  },
  "dependencies": {
    "@microsoft/dev-tunnels-connections": "1.3.56",
    "@microsoft/dev-tunnels-contracts": "1.3.56",
    "@microsoft/dev-tunnels-management": "1.3.56",
    "@microsoft/dev-tunnels-ssh": "3.12.42",
    "@microsoft/dev-tunnels-ssh-tcp": "3.12.42",
    "ldapts": "9.0.0",
    "openid-client": "6.8.8",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "26.5.0",
    "@types/pg": "8.23.1",
    "c8": "12.0.0",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  },
  "overrides": {
    "@microsoft/dev-tunnels-connections": {
      "uuid": "11.1.1"
    }
  }
}
