{
  "name": "devtunnel-toolkit-hub",
  "version": "0.1.0-rc.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test --test-timeout=30000 tests/*.test.mjs",
