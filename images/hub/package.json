    "check:public": "node tests/public-content.mjs"
  },
  "dependencies": {
    "@microsoft/dev-tunnels-connections": "1.3.56",
    "@microsoft/dev-tunnels-contracts": "1.3.56",
    "@microsoft/dev-tunnels-management": "1.3.56",
    "@microsoft/dev-tunnels-ssh": "3.12.42",
    "@microsoft/dev-tunnels-ssh-tcp": "3.12.42",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3",
    "yaml": "2.9.0"
  }
}
