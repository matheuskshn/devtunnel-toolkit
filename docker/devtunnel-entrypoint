#!/usr/bin/env bash
set -euo pipefail

show_help() {
    cat <<'EOF'
DevTunnel Toolkit helper

Usage:
  login [microsoft|github]      Login with device-code flow
  microsoft-login               Login with Microsoft/Entra ID device-code flow
  github-login                  Login with GitHub device-code flow
  logout                        Clear the cached login
  status                        Show current login status
  auth-check                    Verify cached login or access-token auth
  healthcheck                   Check local CLI and Secret Service liveness
  host [devtunnel args...]      Host a tunnel using PORTS/TUNNEL_ID env defaults
  renew [TUNNEL_ID] [--once]    Refresh cached auth after GitHub token expiry
  connect [TUNNEL_ID] [args...] Connect to a tunnel
  raw <devtunnel args...>       Run the devtunnel CLI directly

Environment:
  LOGIN_PROVIDER=microsoft|github Provider used by bare "login"
  DEVTUNNEL_ACCESS_TOKEN        Token passed to host/connect as --access-token
  DEVTUNNEL_EXIT_ON_UNAUTHORIZED=true Exit host process when DevTunnel reports Unauthorized
  DEVTUNNEL_UNAUTHORIZED_EXIT_CODE=75 Exit code used when Unauthorized is detected
  DEVTUNNEL_EXIT_TERMINATION_GRACE_SECONDS=10 Seconds to wait before force-killing host process
  DEVTUNNEL_RENEW_AFTER_EXPIRATION_SECONDS=60 Seconds after GitHub access-token expiry to refresh
  DEVTUNNEL_RENEW_FALLBACK_INTERVAL_SECONDS=29700 Fallback renew interval when expiration cannot be read
  DEVTUNNEL_RENEW_RETRY_SECONDS=300 Delay before retrying a failed renew check
  DEVTUNNEL_RENEW_MIN_SLEEP_SECONDS=30 Minimum sleep when the next renew time is very close
  PORTS=3140,53194              Local ports to expose when -p/--port is omitted
  TUNNEL_ID=my-tunnel           Existing tunnel id to host/connect
  ALLOW_ANONYMOUS=true          Add --allow-anonymous
  PROTOCOL=http|https|auto      Add --protocol
  EXPIRATION=2d                 Add --expiration
  VERBOSE=true                  Add --verbose

Examples:
  login microsoft
  login github
  host
  PORTS=3140,53194 ALLOW_ANONYMOUS=true host
  renew my-tunnel
  renew my-tunnel --once
  connect my-tunnel
  raw user show
EOF
}

start_secret_service() {
    local keyring_env
    local runtime_dir

    if ! command -v dbus-launch >/dev/null || ! command -v gnome-keyring-daemon >/dev/null; then
        return
    fi

    runtime_dir="${XDG_RUNTIME_DIR:-/tmp/devtunnel-runtime}"
    mkdir -p "$runtime_dir"
    chmod 700 "$runtime_dir"
    export XDG_RUNTIME_DIR="$runtime_dir"

    if [[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then
        keyring_env="$(dbus-launch --sh-syntax 2>/dev/null || true)"
        if [[ -n "$keyring_env" ]]; then
            eval "$keyring_env"
        fi
    fi

    keyring_env="$(printf '\n' | gnome-keyring-daemon --unlock 2>/dev/null || true)"
    if [[ -n "$keyring_env" ]]; then
        eval "$keyring_env"
    fi

    keyring_env="$(gnome-keyring-daemon --start --components=secrets 2>/dev/null || true)"
    if [[ -n "$keyring_env" ]]; then
        eval "$keyring_env"
    fi

    # Docker healthchecks do not inherit environment created by the entrypoint.
    # Store only the local bus address, never a login/token or executable shell.
    local health_file
    health_file="$(mktemp "$runtime_dir/health-bus.XXXXXX")"
    printf '%s\n' "${DBUS_SESSION_BUS_ADDRESS:-}" > "$health_file"
    mv -fT -- "$health_file" "$runtime_dir/health-bus"
}

healthcheck_command() {
    local health_file="${XDG_RUNTIME_DIR:-/tmp/devtunnel-runtime}/health-bus"
    local bus_address
    [[ -f "$health_file" && ! -L "$health_file" && -O "$health_file" ]] || return 1
    IFS= read -r bus_address < "$health_file"
    [[ "$bus_address" == unix:* ]] || return 1
    # NameHasOwner does not auto-start a crashed keyring via D-Bus activation.
    dbus-send --bus="$bus_address" --print-reply --reply-timeout=2000 \
        --dest=org.freedesktop.DBus /org/freedesktop/DBus \
        org.freedesktop.DBus.NameHasOwner string:org.freedesktop.secrets \
        | grep -q 'boolean true' || return 1
    dbus-send --bus="$bus_address" --print-reply --reply-timeout=2000 \
        --dest=org.freedesktop.secrets /org/freedesktop/secrets \
        org.freedesktop.DBus.Introspectable.Introspect >/dev/null || return 1
    devtunnel --version >/dev/null
}

is_true() {
    case "${1:-}" in
        1|true|TRUE|yes|YES|on|ON) return 0 ;;
        *) return 1 ;;
    esac
}

has_port_argument() {
    local arg
    for arg in "$@"; do
        case "$arg" in
            -p|--port|--port=*|--port-number|--port-number=*|--port-numbers|--port-numbers=*) return 0 ;;
        esac
    done
    return 1
}

has_access_token_argument() {
    local arg
    for arg in "$@"; do
        case "$arg" in
            -t|--access-token|--access-token=*) return 0 ;;
        esac
    done
    return 1
}

has_help_argument() {
    local arg
    for arg in "$@"; do
        case "$arg" in
            -h|--help|-\?) return 0 ;;
        esac
    done
    return 1
}

devtunnel_auth_args() {
    local access_token
    access_token="$(access_token_value)"

    if [[ -n "$access_token" ]]; then
        printf '%s\n' "--access-token"
        printf '%s\n' "$access_token"
    fi
}

access_token_value() {
    printf '%s' "${DEVTUNNEL_ACCESS_TOKEN:-}"
}

has_cached_login() {
    local output

    if ! output="$(devtunnel user show --json 2>&1)"; then
        printf '%s\n' "$output" >&2
        return 1
    fi

    if printf '%s\n' "$output" | grep -qi '"status"[[:space:]]*:[[:space:]]*"Not logged in"'; then
        return 1
    fi

    return 0
}

cached_login_check_command() {
    if has_cached_login; then
        devtunnel user show
        return 0
    fi

    cat >&2 <<'EOF'
DevTunnel login was not found in this container volume.

Run one of these commands and complete the device-code flow:
  make login-github
  make login-microsoft

Then verify it with:
  make status

If you ran "make reset" or "docker compose down --volumes", the cached login was removed.
EOF
    return 3
}

auth_check_command() {
    local access_token
    access_token="$(access_token_value)"

    if [[ -n "$access_token" ]]; then
        echo "Using DEVTUNNEL_ACCESS_TOKEN for DevTunnel authentication."
        return 0
    fi

    cached_login_check_command
}

ensure_tunnel() {
    local auth_args=()
    local create_args=()
    local line

    [[ -n "${TUNNEL_ID:-}" ]] || return 0

    while IFS= read -r line; do
        auth_args+=("$line")
    done < <(devtunnel_auth_args)

    if devtunnel show "$TUNNEL_ID" "${auth_args[@]}" >/dev/null 2>&1; then
        return 0
    fi

    create_args=("create" "$TUNNEL_ID")

    if [[ -n "${EXPIRATION:-}" ]]; then
        create_args+=("--expiration" "$EXPIRATION")
    fi

    if is_true "${ALLOW_ANONYMOUS:-false}" || is_true "${ANONYMOUS:-false}"; then
        create_args+=("--allow-anonymous")
    fi

    if is_true "${VERBOSE:-false}"; then
        create_args+=("--verbose")
    fi

    devtunnel "${create_args[@]}" "${auth_args[@]}"
}

ensure_tunnel_port() {
    local port="$1"
    local auth_args=()
    local create_args=()
    local line

    [[ -n "${TUNNEL_ID:-}" ]] || return 0

    while IFS= read -r line; do
        auth_args+=("$line")
    done < <(devtunnel_auth_args)

    if devtunnel port show "$TUNNEL_ID" -p "$port" "${auth_args[@]}" >/dev/null 2>&1; then
        return 0
    fi

    create_args=("port" "create" "$TUNNEL_ID" "-p" "$port")

    if [[ -n "${PROTOCOL:-}" ]]; then
        create_args+=("--protocol" "$PROTOCOL")
    fi

    if is_true "${VERBOSE:-false}"; then
        create_args+=("--verbose")
    fi

    devtunnel "${create_args[@]}" "${auth_args[@]}"
}

host_output_is_unauthorized() {
    case "$1" in
        *"Error connecting host tunnel session: Not authorized"*|\
        *"Not authorizedUnauthorized"*|\
        *"Refreshed tunnel access token is not valid"*|\
        *"Tunnel service response status code: Unauthorized"*|\
        *"GitHub token refresh failed."*)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

monitor_host_output() {
    local log_pipe="$1"
    local sentinel_file="$2"
    local line

    while IFS= read -r line; do
        printf '%s\n' "$line"
        if host_output_is_unauthorized "$line"; then
            : > "$sentinel_file"
        fi
    done < "$log_pipe"
}

watch_host_unauthorized() {
    local sentinel_file="$1"
    local child_pid="$2"
    local grace_seconds="${DEVTUNNEL_EXIT_TERMINATION_GRACE_SECONDS:-10}"
    local waited=0

    while kill -0 "$child_pid" 2>/dev/null; do
        if [[ -e "$sentinel_file" ]]; then
            echo "Detected DevTunnel Unauthorized host error; stopping host process for container restart." >&2
            signal_host_child TERM "$child_pid"

            while kill -0 "$child_pid" 2>/dev/null && (( waited < grace_seconds )); do
                sleep 1
                waited="$((waited + 1))"
            done

            if kill -0 "$child_pid" 2>/dev/null; then
                signal_host_child KILL "$child_pid"
            fi

            return 0
        fi

        sleep 1
    done
}

signal_host_child() {
    local signal="$1"
    local child_pid="$2"

    kill "-$signal" -- "-$child_pid" 2>/dev/null || kill "-$signal" "$child_pid" 2>/dev/null || true
}

run_host_process() {
    if ! is_true "${DEVTUNNEL_EXIT_ON_UNAUTHORIZED:-true}"; then
        exec "$@"
    fi

    local runtime_dir="${XDG_RUNTIME_DIR:-/tmp/devtunnel-runtime}"
    local work_dir
    local log_pipe
    local sentinel_file
    local child_pid
    local monitor_pid
    local watcher_pid
    local exit_code

    mkdir -p "$runtime_dir"
    chmod 700 "$runtime_dir"
    work_dir="$(mktemp -d "$runtime_dir/devtunnel-host.XXXXXX")"
    log_pipe="$work_dir/output.pipe"
    sentinel_file="$work_dir/unauthorized"
    mkfifo "$log_pipe"

    monitor_host_output "$log_pipe" "$sentinel_file" &
    monitor_pid="$!"

    if command -v setsid >/dev/null; then
        setsid "$@" > "$log_pipe" 2>&1 &
    else
        "$@" > "$log_pipe" 2>&1 &
    fi
    child_pid="$!"

    watch_host_unauthorized "$sentinel_file" "$child_pid" &
    watcher_pid="$!"

    trap 'signal_host_child TERM "$child_pid"; kill "$monitor_pid" "$watcher_pid" 2>/dev/null || true; rm -rf "$work_dir"; wait "$child_pid" 2>/dev/null || true; exit 143' TERM INT

    set +e
    wait "$child_pid"
    exit_code="$?"
    wait "$monitor_pid" 2>/dev/null
    kill "$watcher_pid" 2>/dev/null
    wait "$watcher_pid" 2>/dev/null
    set -e

    trap - TERM INT

    if [[ -e "$sentinel_file" ]]; then
        echo "Exiting after DevTunnel Unauthorized host error to let Docker restart the service." >&2
        rm -rf "$work_dir"
        return "${DEVTUNNEL_UNAUTHORIZED_EXIT_CODE:-75}"
    fi

    rm -rf "$work_dir"
    return "$exit_code"
}

host_command() {
    shift

    local args=("host")
    local access_token
    local port
    local ports="${PORTS:-${PORT:-3140,53194}}"

    if ! has_access_token_argument "$@"; then
        access_token="$(access_token_value)"
        if [[ -n "$access_token" ]]; then
            args+=("--access-token" "$access_token")
        else
            auth_check_command >/dev/null
        fi
    fi

    if [[ -n "${TUNNEL_ID:-}" ]]; then
        ensure_tunnel
        args+=("${TUNNEL_ID}")
    fi

    if ! has_port_argument "$@"; then
        ports="${ports//,/ }"
        for port in $ports; do
            if [[ -n "${TUNNEL_ID:-}" ]]; then
                ensure_tunnel_port "$port"
            else
                args+=("-p" "$port")
            fi
        done
    fi

    if [[ -n "${PROTOCOL:-}" ]]; then
        args+=("--protocol" "$PROTOCOL")
    fi

    if [[ -n "${EXPIRATION:-}" ]]; then
        args+=("--expiration" "$EXPIRATION")
    fi

    if is_true "${ALLOW_ANONYMOUS:-false}" || is_true "${ANONYMOUS:-false}"; then
        args+=("--allow-anonymous")
    fi

    if is_true "${VERBOSE:-false}"; then
        args+=("--verbose")
    fi

    run_host_process devtunnel "${args[@]}" "$@"
}

connect_command() {
    shift

    local args=("connect")
    local access_token

    if ! has_access_token_argument "$@"; then
        access_token="$(access_token_value)"
        if [[ -n "$access_token" ]]; then
            args+=("--access-token" "$access_token")
        else
            auth_check_command >/dev/null
        fi
    fi

    if [[ -n "${TUNNEL_ID:-}" ]]; then
        args+=("${TUNNEL_ID}")
    elif [[ $# -gt 0 && "${1:0:1}" != "-" ]]; then
        args+=("$1")
        shift
    fi

    exec devtunnel "${args[@]}" "$@"
}

github_token_expiration_epoch() {
    local token_file="${XDG_DATA_HOME:-$HOME/.local/share}/DevTunnels/devtunnels-tokens-github"
    local ticks

    [[ -s "$token_file" ]] || return 1

    ticks="$(grep -o '"expiration":[0-9]*' "$token_file" | head -n 1 | cut -d: -f2 || true)"
    [[ "$ticks" =~ ^[0-9]+$ ]] || return 1

    # GitHub token timestamps are stored by the CLI as Windows FILETIME ticks.
    printf '%s\n' "$((ticks / 10000000 - 11644473600))"
}

format_epoch_utc() {
    date -u -d "@$1" '+%Y-%m-%dT%H:%M:%SZ'
}

renew_sleep_seconds() {
    local expiration_epoch
    local target_epoch
    local now_epoch
    local wait_seconds
    local grace_seconds="${DEVTUNNEL_RENEW_AFTER_EXPIRATION_SECONDS:-60}"
    local fallback_seconds="${DEVTUNNEL_RENEW_FALLBACK_INTERVAL_SECONDS:-29700}"
    local min_sleep_seconds="${DEVTUNNEL_RENEW_MIN_SLEEP_SECONDS:-30}"

    if ! expiration_epoch="$(github_token_expiration_epoch)"; then
        printf '%s\n' "$fallback_seconds"
        return
    fi

    now_epoch="$(date +%s)"
    target_epoch="$((expiration_epoch + grace_seconds))"

    if (( target_epoch <= now_epoch )); then
        printf '0\n'
        return
    fi

    wait_seconds="$((target_epoch - now_epoch))"
    if (( wait_seconds < min_sleep_seconds )); then
        wait_seconds="$min_sleep_seconds"
    fi

    printf '%s\n' "$wait_seconds"
}

run_renew_probe() {
    local tunnel_id="$1"
    local auth_args=()
    local line

    while IFS= read -r line; do
        auth_args+=("$line")
    done < <(devtunnel_auth_args)

    if [[ -n "$tunnel_id" ]]; then
        devtunnel show "$tunnel_id" "${auth_args[@]}" >/dev/null
    else
        devtunnel list "${auth_args[@]}" >/dev/null
    fi
}

renew_command() {
    shift

    local once="false"
    local retry_seconds="${DEVTUNNEL_RENEW_RETRY_SECONDS:-300}"
    local sleep_seconds
    local expiration_epoch
    local tunnel_id="${TUNNEL_ID:-}"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --once)
                once="true"
                ;;
            -*)
                echo "Unsupported renew option: $1" >&2
                return 2
                ;;
            *)
                tunnel_id="$1"
                ;;
        esac
        shift
    done

    if [[ -n "$(access_token_value)" ]]; then
        echo "DEVTUNNEL_ACCESS_TOKEN is set; cached-login renew is not needed."
        if is_true "$once"; then
            return 0
        fi

        while true; do
            sleep "${DEVTUNNEL_RENEW_FALLBACK_INTERVAL_SECONDS:-29700}"
        done
    fi

    if is_true "$once"; then
        run_renew_probe "$tunnel_id"
        return 0
    fi

    while true; do
        if expiration_epoch="$(github_token_expiration_epoch)"; then
            echo "Cached GitHub access token expires at $(format_epoch_utc "$expiration_epoch")."
        else
            echo "Could not read cached GitHub access-token expiration; using fallback interval."
        fi

        sleep_seconds="$(renew_sleep_seconds)"
        if (( sleep_seconds > 0 )); then
            echo "Next DevTunnel auth renew check in ${sleep_seconds}s."
            sleep "$sleep_seconds"
        fi

        echo "Running DevTunnel auth renew check."
        if run_renew_probe "$tunnel_id"; then
            echo "DevTunnel auth renew check succeeded."
        else
            echo "DevTunnel auth renew check failed; retrying in ${retry_seconds}s." >&2
            sleep "$retry_seconds"
        fi
    done
}

login_command() {
    shift

    local provider="${LOGIN_PROVIDER:-microsoft}"

    case "${1:-}" in
        microsoft|ms|entra|aad)
            provider="microsoft"
            shift
            ;;
        github|gh)
            provider="github"
            shift
            ;;
        --github|-g)
            provider="github"
            shift
            ;;
        --microsoft|--entra|--aad)
            provider="microsoft"
            shift
            ;;
        "")
            ;;
        -*)
            ;;
        *)
            echo "Unsupported login provider: $1" >&2
            echo "Use: login microsoft or login github" >&2
            exit 2
            ;;
    esac

    case "$provider" in
        microsoft|ms|entra|aad)
            if has_help_argument "$@"; then
                exec devtunnel user login -e -d "$@"
            fi
            devtunnel user login -e -d "$@"
            ;;
        github|gh)
            if has_help_argument "$@"; then
                exec devtunnel user login -g -d "$@"
            fi
            devtunnel user login -g -d "$@"
            ;;
        *)
            echo "Unsupported login provider: $provider" >&2
            echo "Use: login microsoft or login github" >&2
            exit 2
            ;;
    esac

    echo
    echo "Checking cached login..."
    cached_login_check_command
}

if [[ "${1:-}" == healthcheck ]]; then
    healthcheck_command
    exit $?
fi

start_secret_service

case "${1:-help}" in
    ""|help|--help|-h)
        show_help
        ;;
    login)
        login_command "$@"
        ;;
    microsoft-login|login-microsoft)
        shift
        login_command login microsoft "$@"
        ;;
    github-login|login-github)
        shift
        login_command login github "$@"
        ;;
    logout)
        shift
        exec devtunnel user logout "$@"
        ;;
    status)
        shift
        exec devtunnel user show "$@"
        ;;
    auth-check)
        shift
        auth_check_command "$@"
        ;;
    host)
        host_command "$@"
        ;;
    renew)
        renew_command "$@"
        ;;
    connect)
        connect_command "$@"
        ;;
    raw)
        shift
        exec devtunnel "$@"
        ;;
    *)
        exec devtunnel "$@"
        ;;
esac
